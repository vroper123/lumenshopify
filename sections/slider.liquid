{% schema %}
{
  "name": "Swiper Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 1000,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay speed",
      "default": 3000
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    },
    {
      "type": "range",
      "id": "slides_per_view",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Slides per view",
      "default": 3
    },
    {
      "type": "range",
      "id": "space_between",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Space between slides",
      "default": 30
    },
    {
      "type": "range",
      "id": "transition_speed",
      "min": 100,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "label": "Transition speed",
      "default": 500
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Slide heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Slide description text goes here"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swiper Slider",
      "category": "Image"
    }
  ]
}
{% endschema %}

{% stylesheet %}
<link rel="stylesheet" href="https://unpkg.com/swiper@8/swiper-bundle.min.css" />
<style>
  .swiper {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 0;
  }

  .swiper-slide {
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .swiper-slide img {
    max-width: 100%;
    height: auto;
    margin-bottom: 15px;
  }

  .swiper-button-next,
  .swiper-button-prev {
    color: #000;
  }

  .swiper-pagination-bullet-active {
    background: #000;
  }
</style>
{% endstylesheet %}

{% javascript %}
<script src="https://unpkg.com/swiper@8/swiper-bundle.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
  const swiperContainers = document.querySelectorAll('.swiper-container-{{ section.id }}');
  
  swiperContainers.forEach(container => {
    const swiper = new Swiper(container, {
      // Settings from section schema
      loop: {{ section.settings.loop }},
      autoplay: {{ section.settings.autoplay }} ? {
        delay: {{ section.settings.autoplay_speed }},
        disableOnInteraction: false,
      } : false,
      speed: {{ section.settings.transition_speed }},
      slidesPerView: {{ section.settings.slides_per_view }},
      spaceBetween: {{ section.settings.space_between }},
      
      // Navigation arrows
      navigation: {{ section.settings.show_arrows }} ? {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      } : false,
      
      // Pagination dots
      pagination: {{ section.settings.show_pagination }} ? {
        el: '.swiper-pagination',
        clickable: true,
      } : false,
      
      // Responsive breakpoints
      breakpoints: {
        640: {
          slidesPerView: 2,
          spaceBetween: 20
        },
        1024: {
          slidesPerView: {{ section.settings.slides_per_view }},
          spaceBetween: {{ section.settings.space_between }}
        }
      }
    });
  });
});
</script>
{% endjavascript %}

<div class="swiper-container-{{ section.id }} swiper">
  <div class="swiper-wrapper">
    {% for block in section.blocks %}
      <div class="swiper-slide" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: '800x' }}" alt="{{ block.settings.image.alt }}">
        {% endif %}
        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.show_pagination %}
    <div class="swiper-pagination"></div>
  {% endif %}

  {% if section.settings.show_arrows %}
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
  {% endif %}
</div>