<article>
    {% for block in section.blocks %}
      {% case block.type %}
        {% when "article_title" %}
            <div class="flex items-center justify-center ">
                <div class="max-w-7xl text-center">
                    <a href="{{blog.url}}" class="text-base text-gray-500 uppercase font-bold hover:text-gray-900">{{blog.title}}</a>
                    <h1 class="text-4xl md:text-6xl font-medium">
                       {{article.title}}
                    </h1>
                </div>
            </div>
        {% when "article_author" %} 
          <div class="flex items-center justify-center text-center">
                <div class="max-w-7xl">   
                {% if section.settings.enabled_author %}
                    <small>{{article.author}}</small>
                {% endif %}
            </div>
           </div> 
        {% when "article_date" %}
         <div class="flex items-center justify-center text-center">
                <div class="max-w-7xl">     
          {% if section.settings.enabled_date %}
                <time datetime="{{ article.created_at | date: format: 'date' }}">{{ article.created_at | date: format: 'date' }}</time>
            {% endif %}
         </div>   
         </div>
        {% when "featured_image" %}
          <div class="max-w-7xl bg-blue-100 rounded-lg mx-2 md:mx-auto overflow-hidden">
            {% if article.image %}
                 <img class="w-full h-80 md:h-96 object-cover object-center my-4" src="{{ article.image | image_url: width: 800, height:800 }}" alt="{{ article.image.alt | escape }}">
                 {% else %}
                 {{ 'blog-apparel-1' | placeholder_svg_tag: "w-full h-80 md:h-96 object-cover object-center my-4" }}
            {% endif %}
          </div>  
        {% when "article_content" %}
            
             <div class="max-w-7xl mx-auto">
                {{article.content}}
            </div>
            
        {% else %}
            
      {% endcase %}
{% endfor %}

</article>

{% schema %}
    {
        "name": "Template Articles",
         "settings": [
            {
                "type": "checkbox",
                "default":true,
                "id": "enabled_author",
                "label": "Display Author"
            },
              {
                "type": "checkbox",
                "default":true,
                "id": "enabled_date",
                "label": "Display Published Date"
            }
         ],
         "blocks": [
            {
                "name": "Article Title",
                "type": "article_title",
                "limit": 1
            },
               {
                "name": "Author",
                "type": "article_author",
                "limit": 1
            },
               {
                "name": "Date",
                "type": "article_date",
                "limit": 1
            },
               {
                "name": "Featured Image",
                "type": "featured_image",
                "limit": 1
            },
               {
                "name": "Article Content",
                "type": "article_content",
                "limit": 1
            }
         ]
    }
{% endschema %}